{
  "name": "spectra-peel",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --filter @spectra-peel/web dev",
    "build": "bun --filter @spectra-peel/web build",
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsgo -p packages/engine && tsgo -p apps/web && tsgo -p e2e",
    "test": "vitest run",
    "lint:dup": "jscpd",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "jscpd": "5.4.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
